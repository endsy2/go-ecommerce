# Copy to backend/.env and adjust. .env is gitignored and must never be committed.
#
# The Postgres values here match docker-compose.yml, so the defaults work as-is
# for local development. Every value is a placeholder — no real secret belongs
# in this file.

# development enables text logging, debug level, and GORM SQL statement logging.
# Any other value switches to JSON logs at info level.
APP_ENV=development

# --- HTTP -------------------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
# How long in-flight requests get to finish after Ctrl+C / SIGTERM.
HTTP_SHUTDOWN_TIMEOUT=15s
# Comma-separated. Must list the frontend origin exactly; "*" will not work
# because the API sends credentials (the auth cookie).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Postgres (required) ----------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_dev_password
POSTGRES_DB=ecommerce
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=5m

# Apply pending migrations on startup, so `go run ./cmd/api` brings the schema
# up to date by itself. Defaults to true in development and false everywhere
# else, where migrating is a deploy step (`go run ./cmd/migrate up`) rather than
# something every instance races to do while booting.
#
# This runs the same versioned migrations as cmd/migrate — internal/migration,
# written in Go against GORM — so a database built this way is identical to one
# migrated as a deploy step, CHECK constraints and ON DELETE rules included.
POSTGRES_AUTO_MIGRATE=true

# --- JWT (required) ---------------------------------------------------------
# The HMAC signing key. REQUIRED, with no default and a minimum of 32
# characters — the app refuses to start otherwise. A short key can be
# brute-forced offline from a single captured token, after which anyone can mint
# an admin session.
#
# Generate a real one, do not type one:
#   openssl rand -base64 48
#
# The value below is a placeholder for local development only. Never reuse it
# anywhere real, and never commit a production key to this file.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789

# How long an issued token stays valid. Also the lifetime of the auth cookie.
JWT_EXPIRY=24h

# --- Redis (optional; app starts degraded if unreachable) -------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s
