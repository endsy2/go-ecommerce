# Secrets — never commit. Only .env.example belongs in git.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx

# Claude Code — settings.json, commands/ and hooks/ are shared and committed.
# settings.local.json holds per-developer permission overrides.
.claude/settings.local.json

# Go
/backend/bin/
/backend/api
/backend/migrate
*.exe
*.test
*.out

